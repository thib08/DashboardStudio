<UserControl
    x:Class="DashboardStudio.App.Views.MainView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewModels="clr-namespace:DashboardStudio.App.ViewModels"
    MinWidth="1000"
    MinHeight="650">

    <UserControl.DataContext>
        <viewModels:MainViewModel />
    </UserControl.DataContext>

    <Grid Background="{DynamicResource BackgroundPrimaryBrush}">

        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="*" />
            <RowDefinition Height="70" />
        </Grid.RowDefinitions>

        <!--  =================================================  -->
        <!--  BARRE SUPÉRIEURE  -->
        <!--  =================================================  -->

        <Border
            Grid.Row="0"
            Background="{DynamicResource BackgroundSecondaryBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,0,1">

            <Grid Margin="20,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!--  Logo  -->

                <StackPanel
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">

                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="22"
                        FontWeight="Bold"
                        Foreground="{DynamicResource AccentBrush}"
                        Text="DS" />

                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        Text="  Dashboard Studio" />

                </StackPanel>

                <!--  Projet  -->

                <StackPanel
                    Grid.Column="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">

                    <TextBlock
                        Margin="0,0,6,0"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        Text="Projet :" />

                    <TextBlock
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        Text="Mon Dashboard" />

                </StackPanel>

                <!--  Paramètres  -->

                <Button
                    Grid.Column="2"
                    Width="40"
                    Height="40"
                    Background="Transparent"
                    BorderThickness="0"
                    Content="⚙"
                    FontSize="20"
                    Foreground="{DynamicResource TextPrimaryBrush}" />

            </Grid>

        </Border>


        <!--  =================================================  -->
        <!--  CONTENU PRINCIPAL  -->
        <!--  =================================================  -->

        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>

                <!--  Navigation  -->

                <ColumnDefinition Width="220" />

                <!--  Canvas  -->

                <ColumnDefinition Width="*" />

                <!--  Inspecteur  -->

                <ColumnDefinition Width="260" />

            </Grid.ColumnDefinitions>


            <!--  =================================================  -->
            <!--  BARRE LATÉRALE  -->
            <!--  =================================================  -->

            <Border
                Grid.Column="0"
                Background="{DynamicResource BackgroundSecondaryBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,1,0">

                <ScrollViewer VerticalScrollBarVisibility="Auto">

                    <StackPanel Margin="16">

                        <TextBlock
                            Margin="8,8,8,12"
                            FontSize="11"
                            FontWeight="Bold"
                            Foreground="{DynamicResource TextSecondaryBrush}"
                            Text="DASHBOARDS" />

                        <ListBox
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{DynamicResource TextPrimaryBrush}"
                            ItemsSource="{Binding Dashboards}"
                            SelectedItem="{Binding SelectedDashboard, Mode=TwoWay}">

                            <ListBox.ItemTemplate>

                                <DataTemplate>

                                    <TextBlock
                                        Padding="12,10"
                                        FontSize="14"
                                        Text="{Binding Name}" />

                                </DataTemplate>

                            </ListBox.ItemTemplate>

                        </ListBox>


                        <Separator Margin="0,16" Background="{DynamicResource BorderBrush}" />


                        <TextBlock
                            Margin="8,0,8,12"
                            FontSize="11"
                            FontWeight="Bold"
                            Foreground="{DynamicResource TextSecondaryBrush}"
                            Text="PAGES" />

                        <ListBox
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{DynamicResource TextPrimaryBrush}"
                            ItemsSource="{Binding SelectedDashboardViewModel.Pages}"
                            SelectedItem="{Binding SelectedPage, Mode=TwoWay}">

                            <ListBox.ItemTemplate>

                                <DataTemplate>

                                    <TextBlock
                                        Padding="12,10"
                                        FontSize="14"
                                        Text="{Binding Name}" />

                                </DataTemplate>

                            </ListBox.ItemTemplate>

                        </ListBox>

                        <Separator Margin="0,16" Background="{DynamicResource BorderBrush}" />

                        <TextBlock
                            Margin="8,0,8,12"
                            FontSize="11"
                            FontWeight="Bold"
                            Foreground="{DynamicResource TextSecondaryBrush}"
                            Text="COMPOSANTS" />


                        <Button
                            Height="40"
                            Padding="12,0"
                            HorizontalContentAlignment="Left"
                            Background="Transparent"
                            BorderThickness="0"
                            Content="◇  CPU"
                            Foreground="{DynamicResource TextSecondaryBrush}" />

                        <Button
                            Height="40"
                            Padding="12,0"
                            HorizontalContentAlignment="Left"
                            Background="Transparent"
                            BorderThickness="0"
                            Content="◇  GPU"
                            Foreground="{DynamicResource TextSecondaryBrush}" />

                        <Button
                            Height="40"
                            Padding="12,0"
                            HorizontalContentAlignment="Left"
                            Background="Transparent"
                            BorderThickness="0"
                            Content="◇  Mémoire"
                            Foreground="{DynamicResource TextSecondaryBrush}" />

                        <Button
                            Height="40"
                            Padding="12,0"
                            HorizontalContentAlignment="Left"
                            Background="Transparent"
                            BorderThickness="0"
                            Content="◇  Musique"
                            Foreground="{DynamicResource TextSecondaryBrush}" />

                        <Button
                            Height="40"
                            Padding="12,0"
                            HorizontalContentAlignment="Left"
                            Background="Transparent"
                            BorderThickness="0"
                            Content="◇  MSFS"
                            Foreground="{DynamicResource TextSecondaryBrush}" />

                    </StackPanel>

                </ScrollViewer>

            </Border>


            <!--  =================================================  -->
            <!--  ZONE DE TRAVAIL  -->
            <!--  =================================================  -->

            <Border
                Grid.Column="1"
                Padding="24"
                Background="{DynamicResource BackgroundPrimaryBrush}">

                <Grid>

                    <Border
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12">

                        <Grid>

                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="26"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextPrimaryBrush}"
                                    Text="{Binding SelectedDashboardName}" />

                                <TextBlock
                                    Margin="0,12,0,0"
                                    HorizontalAlignment="Center"
                                    FontSize="18"
                                    Foreground="{DynamicResource AccentBrush}"
                                    Text="{Binding SelectedPage.Name}" />

                                <TextBlock
                                    Margin="0,8,0,0"
                                    HorizontalAlignment="Center"
                                    FontSize="14"
                                    Foreground="{DynamicResource TextSecondaryBrush}"
                                    Text="La grille du dashboard sera affichée ici" />

                            </StackPanel>

                        </Grid>

                    </Border>

                </Grid>

            </Border>


            <!--  =================================================  -->
            <!--  INSPECTEUR  -->
            <!--  =================================================  -->

            <Border
                Grid.Column="2"
                Background="{DynamicResource BackgroundSecondaryBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1,0,0,0">

                <StackPanel Margin="20">

                    <TextBlock
                        Margin="0,8,0,20"
                        FontSize="11"
                        FontWeight="Bold"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        Text="PROPRIÉTÉS" />

                    <TextBlock
                        FontSize="16"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        Text="Aucune sélection" />

                    <TextBlock
                        Margin="0,8,0,0"
                        FontSize="13"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        Text="Sélectionnez un composant dans le dashboard pour afficher ses propriétés."
                        TextWrapping="Wrap" />

                </StackPanel>

            </Border>

        </Grid>


        <!--  =================================================  -->
        <!--  BIBLIOTHÈQUE  -->
        <!--  =================================================  -->

        <Border
            Grid.Row="2"
            Background="{DynamicResource BackgroundSecondaryBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,1,0,0">

            <Grid Margin="20,0">

                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">

                    <TextBlock
                        Margin="0,0,24,0"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        Text="Bibliothèque" />

                    <Button
                        Height="38"
                        Padding="16,0"
                        Background="{DynamicResource AccentBrush}"
                        BorderThickness="0"
                        Content="+ Ajouter un composant"
                        Foreground="White" />

                    <Button
                        Height="38"
                        Margin="8,0,0,0"
                        Padding="16,0"
                        Background="Transparent"
                        BorderThickness="0"
                        Content="Templates"
                        Foreground="{DynamicResource TextSecondaryBrush}" />

                </StackPanel>

            </Grid>

        </Border>

    </Grid>

</UserControl>